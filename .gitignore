# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local images (large binaries, not source code)
Images/

# drizzle migrations meta
drizzle/

# regenerable offline audit export (scripts/export-tennis-engine-for-audit.mjs)
tennis-engine-audit-export/

# local scratch dump from a pre-rollover archive step, not source
scratch-*.json

# Sentry Config File
.env.sentry-build-plugin
.env.local

# sensitive documents — never commit credentials or business docs
docs/
*.docx
*.doc
*.xlsx
*.xls

# scratch/debug output — research dumps, scraped pages, throwaway scripts
scratchpad/
scratchpad-*
scratchpad_*
.dev-server.log
.dev-server-err.log
Capture.PNG

# handoff/delivery packages and raw data dumps — not source code
*.zip
deliverables/
scripts/_rg27-source/
scripts/*-audit.csv
scripts/*-changes.csv
scripts/*-conflicts.csv
scripts/*-for-review.csv
scripts/regression-output.jsonl
scripts/_build-*-audit.mjs
scripts/_export-*-handoff.mjs
scripts/_export-*-pending-explanations.mjs
Roland_Garros_2027_Post_C4_Q3_Explanation_Final_Editorial_Patched.csv
